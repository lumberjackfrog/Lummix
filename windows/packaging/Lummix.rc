1 ICON "@ICON@"
1 VERSIONINFO
FILEVERSION @NUMERIC@
PRODUCTVERSION @NUMERIC@
FILEOS 0x40004
FILETYPE 1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Lummix\0"
            VALUE "FileDescription", "Lummix desktop mixer\0"
            VALUE "FileVersion", "@VERSION@\0"
            VALUE "InternalName", "Lummix\0"
            VALUE "OriginalFilename", "Lummix.exe\0"
            VALUE "ProductName", "Lummix\0"
            VALUE "ProductVersion", "@VERSION@\0"
            VALUE "LegalCopyright", "Copyright 2026 Lummix contributors\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
